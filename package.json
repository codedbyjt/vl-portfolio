{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:custom-domain": "vite build --config vite.custom-domain.config.ts",
    "postbuild": "cp dist/index.html dist/404.html",
    "postbuild:custom-domain": "cp dist/index.html dist/404.html",
    "dev": "node scripts/start-dev.mjs",
    "dev:tunnel": "VITE_TUNNEL_HMR=true vite --host 0.0.0.0 --port 5173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:custom-domain": "npm run build:custom-domain && npm run postbuild:custom-domain && gh-pages -d dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.106.2",
    "framer-motion": "^12.29.2",
    "jszip": "^3.10.1",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "gh-pages": "^6.2.0",
    "localtunnel": "^2.0.2",
    "tailwindcss": "4.1.12",
    "vite": "^6.4.1"
  },
  "peerDependenciesMeta": {},
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
